version 1;
package axus::node;

use axus::model::AssetKey;
use axus::model::NodeProfile;

/// The nodes that advertise an AssetKey and how many hops the advertisement may still travel.
#[rust::derive(Eq)]
struct LocationEntry {
  @0 hops: u32;
  @1 node_profiles: Vec<NodeProfile>[..=MAX_LOCATION_NODE_PROFILES];
}

/// One message per purpose. Hello and Profile precede the established phase; the rest carry the work.
#[rust::derive(Eq)]
enum NodeMessage {
  @1 Hello {
    @1 version: u32;
  };
  @2 Profile {
    @1 node_profile: NodeProfile;
  };
  @3 Status;
  @4 AnnounceProfiles {
    @1 node_profiles: Vec<NodeProfile>[..=MAX_ANNOUNCE_NODE_PROFILES];
  };
  @5 AnnounceLocations {
    @1 locations: Map<AssetKey, LocationEntry>[..=MAX_ANNOUNCE_ASSET_KEYS];
  };
}

const MAX_HOPS: u32 = 3;
const MAX_ANNOUNCE_NODE_PROFILES: u32 = 32;
const MAX_ANNOUNCE_ASSET_KEYS: u32 = 1024;
const MAX_LOCATION_NODE_PROFILES: u32 = 8;
const MAX_MESSAGE_LENGTH: u32 = 262144;

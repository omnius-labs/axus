        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.0",
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "^4.1.0",
        "@types/node": "26.6.6",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.2.1",
        "tailwindcss": "^4.1.0",
        "typescript": "~7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    }
